<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ポケモンカード POKÉPOKE STYLE</title>
    <!-- アイコンフォントの読み込み -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* 
           ポケポケ風のプレミアムデザイン！
           ガラスモーフィズムとキラキラエフェクトで豪華にします。
        */
        :root {
            --primary-bg: #f0f4f8;
            --glass: rgba(255, 255, 255, 0.7);
            --p1-color: #3b82f6;
            --p2-color: #ef4444;
            --gold: #f59e0b;
            --shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            --card-radius: 12px;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Outfit', 'Hiragino Kaku Gothic ProN', sans-serif;
            background: linear-gradient(135deg, #e0eafc 0%, #cfdef3 100%);
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        #game-container {
            width: 100%;
            height: 100%;
            max-width: 480px;
            max-height: 900px;
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 0;
            display: flex;
            flex-direction: column;
            position: relative;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
            margin: 0;
        }

        @media (min-width: 500px) {
            #game-container {
                margin: 20px;
                height: 95vh;
                border-radius: 30px;
            }
        }

        header {
            padding: 20px;
            text-align: center;
        }

        h1 {
            margin: 0;
            font-size: 22px;
            color: #1e293b;
            letter-spacing: 2px;
            font-weight: 900;
        }

        /* 画面きりかえ */
        .screen {
            flex: 1;
            display: none;
            padding: 20px;
            flex-direction: column;
            overflow: hidden;
        }

        .screen.active {
            display: flex;
        }

        /* セットアップ画面 */
        .setup-columns {
            display: flex;
            flex-direction: column;
            gap: 10px;
            height: 100%;
        }

        .player-setup {
            flex: 1;
            background: rgba(255, 255, 255, 0.4);
            border-radius: 20px;
            padding: 10px;
            display: flex;
            flex-direction: column;
            border: 1px solid rgba(255, 255, 255, 0.5);
            overflow: hidden;
        }

        .player-setup h2 {
            margin: 0 0 8px 0;
            font-size: 14px;
            text-align: left;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .card-list {
            flex: 1;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            overflow-y: auto;
            padding: 2px;
            -webkit-overflow-scrolling: touch;
        }

        /* ポケポケ風カードアイテム */
        .card-item {
            aspect-ratio: 2 / 3;
            background: #fff;
            border-radius: var(--card-radius);
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            padding: 5px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            border: 2px solid transparent;
        }

        .card-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
        }

        .card-item.selected {
            border-color: var(--p1-color);
            transform: scale(0.95);
            background: #f0f7ff;
        }

        .card-item i {
            font-size: 24px;
        }

        .card-name {
            font-size: 9px;
            margin-top: 4px;
            color: #334155;
            font-weight: bold;
        }

        /* バトル画面 */
        #battle-screen {
            background: radial-gradient(circle at center, #ffffff 0%, #e0eafc 100%);
            padding: 0;
            justify-content: space-between;
        }

        .battle-area {
            flex: 1;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            perspective: 1000px;
        }

        /* 3Dカードコンテナ */
        .active-card-container {
            width: 180px;
            aspect-ratio: 2 / 3;
            background: #fff;
            border-radius: 15px;
            display: flex;
            flex-direction: column;
            padding: 15px;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.1s ease;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }

        /* キラキラエフェクト (Glare) */
        .card-glare {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0) 50%, rgba(255, 255, 255, 0.4) 100%);
            pointer-events: none;
            z-index: 10;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .active-card-container:hover .card-glare {
            opacity: 1;
        }

        .stat-display-bl {
            position: absolute;
            bottom: 15px;
            left: 15px;
            font-size: 10px;
            font-weight: 800;
            color: #1e293b;
            background: rgba(255, 255, 255, 0.8);
            padding: 4px 8px;
            border-radius: 10px;
            backdrop-filter: blur(5px);
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        .hp-bar-outer {
            width: 100%;
            height: 10px;
            background: #e2e8f0;
            border-radius: 5px;
            margin: 10px 0;
            overflow: hidden;
        }

        .hp-bar-inner {
            height: 100%;
            background: linear-gradient(90deg, #10b981, #34d399);
            width: 100%;
            transition: width 0.3s ease;
        }

        /* 下部UIセクション */
        #bottom-ui {
            background: var(--glass);
            border-top: 1px solid rgba(255, 255, 255, 0.3);
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            border-radius: 30px 30px 0 0;
        }

        #log-area {
            height: 80px;
            overflow-y: auto;
            font-size: 13px;
            color: #475569;
            padding: 5px;
        }

        #command-area {
            display: flex;
            gap: 10px;
        }

        .cmd-btn {
            flex: 1;
            height: 50px;
            border: none;
            border-radius: 15px;
            background: #1e293b;
            color: #fff;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .cmd-btn:hover:not(:disabled) {
            background: #334155;
            transform: translateY(-2px);
        }

        .cmd-btn:disabled {
            opacity: 0.3;
            transform: none;
        }

        #start-btn {
            width: 80%;
            margin: 20px auto;
            padding: 15px;
            border-radius: 30px;
            background: var(--p1-color);
            color: white;
            border: none;
            font-weight: 900;
            font-size: 18px;
            cursor: pointer;
            box-shadow: 0 10px 20px rgba(59, 130, 246, 0.4);
        }

        /* スクロールバー非表示 */
        ::-webkit-scrollbar {
            width: 0;
        }
    </style>
</head>

<body>

    <div id="game-container">
        <header>
            <h1>POKÉPOKE BATTLE</h1>
        </header>

        <!-- デッキ選択画面 -->
        <div id="setup-screen" class="screen active">
            <div class="setup-columns">
                <!-- プレイヤー1 -->
                <div class="player-setup">
                    <h2 class="p1-title"><i class="fas fa-user"></i> プレイヤー 1</h2>
                    <div id="p1-card-list" class="card-list"></div>
                    <div class="selection-count">せんたく: <span id="p1-count">0</span> / 6</div>
                </div>
                <!-- プレイヤー2 -->
                <div class="player-setup">
                    <h2 class="p2-title"><i class="fas fa-robot"></i> プレイヤー 2</h2>
                    <div id="p2-card-list" class="card-list"></div>
                    <div class="selection-count">せんたく: <span id="p2-count">0</span> / 6</div>
                </div>
            </div>
            <button id="start-btn" onclick="startGame()">バトル開始！</button>
        </div>

        <!-- バトル画面 -->
        <div id="battle-screen" class="screen">
            <!-- 相手エリア -->
            <div class="battle-area">
                <div id="p2-active-card" class="active-card-container">
                    <!-- ここにカードが入ります -->
                </div>
            </div>

            <!-- 自分エリア -->
            <div class="battle-area">
                <div id="p1-active-card" class="active-card-container">
                    <!-- ここにカードが入ります -->
                </div>
            </div>

            <!-- 下部UI -->
            <div id="bottom-ui">
                <div id="log-area"></div>
                <div id="command-area">
                    <button class="cmd-btn" id="attack-btn" onclick="handleAction('attack')">たたかう</button>
                    <button class="cmd-btn" id="switch-btn" onclick="handleAction('switch')">いれかえ</button>
                </div>
            </div>

            <!-- セレクションオーバーレイ (技・ポケモン選択用) -->
            <div id="selection-overlay" class="selection-overlay">
                <div class="selection-content">
                    <h3 id="selection-title">せんたくしてください</h3>
                    <div id="selection-list" class="selection-list"></div>
                    <button class="close-btn" onclick="closeOverlay()">もどる</button>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* 追記スタイル */
        .selection-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(8px);
            z-index: 100;
            display: none;
            justify-content: center;
            align-items: center;
        }

        .selection-content {
            width: 85%;
            max-height: 70%;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        }

        .selection-list {
            flex: 1;
            overflow-y: auto;
            margin: 15px 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding-right: 5px;
        }

        .select-item {
            padding: 15px;
            background: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s;
        }

        .select-item:hover {
            background: #f1f5f9;
            border-color: var(--p1-color);
        }

        .close-btn {
            padding: 12px;
            background: #1e293b;
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: bold;
        }
    </style>

    <script>
        /**
         * ポケモンのデータ
         */
        const MASTER_CARDS = [
            { name: "メガリザードンX", icon: "fa-fire", H: 220, I: 50, J: "炎/龍", G: 60, F: 50, D: 60, A: 110, color: "#333333", moves: [{ n: "フレアドライブ", d: 150 }, { n: "ドラゴンテール", d: 80 }] },
            { name: "ドラパルト", icon: "fa-ghost", H: 150, I: 40, J: "龍/霊", G: 100, F: 40, D: 40, A: 80, color: "#4b0082", moves: [{ n: "ドラゴンアロー", d: 50 }, { n: "シャドーダイブ", d: 100 }] },
            { name: "プクリン", icon: "fa-smile", H: 200, I: 30, J: "無/妖", G: 30, F: 90, D: 40, A: 40, color: "#ffc0cb", moves: [{ n: "ハイパーボイス", d: 60 }, { n: "うたう", d: 0 }] },
            { name: "メガユキノオー", icon: "fa-snowflake", H: 190, I: 40, J: "草/氷", G: 20, F: 50, D: 80, A: 90, color: "#f0ffff", moves: [{ n: "ウッドハンマー", d: 120 }, { n: "ふぶき", d: 110 }] },
            { name: "メガルカリオ", icon: "fa-fist-raised", H: 180, I: 50, J: "闘/鋼", G: 70, F: 40, D: 50, A: 100, color: "#4169e1", moves: [{ n: "インファイト", d: 120 }, { n: "バレットパンチ", d: 40 }] },
            { name: "ピカチュウ", icon: "fa-bolt", H: 60, I: 10, J: "雷", G: 70, F: 30, D: 20, A: 40, color: "#ffd700", moves: [{ n: "10万ボルト", d: 90 }, { n: "でんこうせっか", d: 40 }] },
            { name: "ブースターEX", icon: "fa-fire", H: 170, I: 30, J: "炎", G: 50, F: 40, D: 30, A: 70, color: "#ff4500", moves: [{ n: "フレアドライブ", d: 120 }, { n: "かえんほうしゃ", d: 90 }] },
            { name: "ニンフィアEX", icon: "fa-heart", H: 170, I: 20, J: "フェアリー", G: 40, F: 50, D: 40, A: 60, color: "#ffb6c1", moves: [{ n: "マジカルシャイン", d: 110 }, { n: "ドレインキッス", d: 50 }] },
            { name: "メガサーナイトEX", icon: "fa-star", H: 210, I: 50, J: "フェアリー", G: 60, F: 60, D: 50, A: 90, color: "#dda0dd", moves: [{ n: "ムーンフォース", d: 120 }, { n: "サイコキネシス", d: 90 }] },
            { name: "メガレックウザEX", icon: "fa-dragon", H: 230, I: 60, J: "龍/無", G: 90, F: 40, D: 60, A: 120, color: "#3cb371", moves: [{ n: "画龍点睛", d: 300 }, { n: "ガリョウテンセイ", d: 300 }] },
            { name: "シェイミEX", icon: "fa-leaf", H: 110, I: 40, J: "無", G: 80, F: 70, D: 30, A: 30, color: "#98fb98", moves: [{ n: "シードフレア", d: 120 }, { n: "エナジーボール", d: 90 }] },
            { name: "MミュウツーEX", icon: "fa-brain", H: 210, I: 70, J: "超", G: 70, F: 50, D: 50, A: 100, color: "#ba55d3", moves: [{ n: "サイコブレイク", d: 150 }, { n: "サイコショット", d: 60 }] },
            { name: "ボルケニオンEX", icon: "fa-steam", H: 180, I: 40, J: "炎/水", G: 30, F: 50, D: 70, A: 80, color: "#cd5c5c", moves: [{ n: "スチームバースト", d: 130 }, { n: "ハイドロポンプ", d: 110 }] },
            { name: "ゼルネアスEX", icon: "fa-gem", H: 170, I: 60, J: "フェアリー", G: 40, F: 60, D: 40, A: 70, color: "#87cefa", moves: [{ n: "ジオコントロール", d: 0 }, { n: "ムーンフォース", d: 130 }] },
            { name: "イベルタルEX", icon: "fa-crow", H: 170, I: 60, J: "悪/飛", G: 50, F: 50, D: 40, A: 70, color: "#a52a2a", moves: [{ n: "デスウイング", d: 90 }, { n: "あくのはどう", d: 80 }] },
            { name: "デデンネ", icon: "fa-mouse", H: 70, I: 20, J: "フェアリー", G: 60, F: 80, D: 20, A: 20, color: "#f0e68c", moves: [{ n: "ほっぺすりすり", d: 10 }, { n: "ほうでん", d: 60 }] },
            { name: "フーパEX", icon: "fa-ghost", H: 170, I: 80, J: "超", G: 40, F: 40, D: 30, A: 80, color: "#9370db", moves: [{ n: "いじげんラッシュ", d: 100 }, { n: "いじげんホール", d: 80 }] }
        ];

        let p1Deck = [];
        let p2Deck = [];
        let p1BattleDeck = [];
        let p2BattleDeck = [];
        let p1ActiveIndex = 0;
        let p2ActiveIndex = 0;
        let turn = 1;
        let isGameOver = false;

        function initSetup() {
            renderCardList("p1");
            renderCardList("p2");
        }

        function renderCardList(pId) {
            const listEl = document.getElementById(pId + "-card-list");
            listEl.innerHTML = "";
            MASTER_CARDS.forEach(function (card, index) {
                const item = document.createElement("div");
                item.className = "card-item";
                item.innerHTML =
                    '<i class="fas ' + card.icon + '" style="color:' + card.color + '"></i>' +
                    '<div class="card-name">' + card.name + '</div>';
                item.onclick = function () {
                    toggleCardSelection(pId, index, item);
                };
                listEl.appendChild(item);
            });
        }

        function toggleCardSelection(pId, cardIndex, element) {
            const deck = (pId === "p1") ? p1Deck : p2Deck;
            const countEl = document.getElementById(pId + "-count");
            const foundIndex = deck.indexOf(cardIndex);
            if (foundIndex > -1) {
                deck.splice(foundIndex, 1);
                element.classList.remove("selected");
            } else {
                if (deck.length < 6) {
                    deck.push(cardIndex);
                    element.classList.add("selected");
                }
            }
            countEl.innerText = deck.length;
            document.getElementById("start-btn").style.display = (p1Deck.length === 6 && p2Deck.length === 6) ? "block" : "none";
        }

        function startGame() {
            p1BattleDeck = p1Deck.map(function (idx) { return JSON.parse(JSON.stringify(MASTER_CARDS[idx])); });
            p2BattleDeck = p2Deck.map(function (idx) { return JSON.parse(JSON.stringify(MASTER_CARDS[idx])); });
            document.getElementById("setup-screen").classList.remove("active");
            document.getElementById("battle-screen").classList.add("active");
            addLog("バトル開始！");
            updateBattleUI();
        }

        function handleAction(type) {
            if (isGameOver) return;
            if (type === 'attack') {
                showMoveMenu();
            } else if (type === 'switch') {
                showSwitchMenu();
            }
        }

        function showMoveMenu() {
            const attacker = (turn === 1) ? p1BattleDeck[p1ActiveIndex] : p2BattleDeck[p2ActiveIndex];
            const overlay = document.getElementById("selection-overlay");
            const list = document.getElementById("selection-list");
            document.getElementById("selection-title").innerText = "わざをえらんでください";
            list.innerHTML = "";

            attacker.moves.forEach(function (move) {
                const item = document.createElement("div");
                item.className = "select-item";
                item.innerHTML = '<span>' + move.n + '</span><span style="font-weight:900; color:' + (turn === 1 ? 'var(--p1-color)' : 'var(--p2-color)') + '">威力 ' + move.d + '</span>';
                item.onclick = function () {
                    closeOverlay();
                    executeAttack(move);
                };
                list.appendChild(item);
            });
            overlay.style.display = "flex";
        }

        function showSwitchMenu() {
            const deck = (turn === 1) ? p1BattleDeck : p2BattleDeck;
            const overlay = document.getElementById("selection-overlay");
            const list = document.getElementById("selection-list");
            document.getElementById("selection-title").innerText = "ポケモンをえらんでください";
            list.innerHTML = "";

            deck.forEach(function (p, i) {
                if (i === (turn === 1 ? p1ActiveIndex : p2ActiveIndex)) return; // 出場中は飛ばす

                const item = document.createElement("div");
                item.className = "select-item";
                if (p.H <= 0) item.style.opacity = "0.4";

                item.innerHTML =
                    '<div style="display:flex; align-items:center; gap:10px;"><i class="fas ' + p.icon + '"></i> ' + p.name + '</div>' +
                    '<span style="font-size:12px;">HP ' + p.H + '</span>';

                if (p.H > 0) {
                    item.onclick = function () {
                        if (turn === 1) p1ActiveIndex = i; else p2ActiveIndex = i;
                        addLog("P" + turn + " は " + p.name + " に交代した！");
                        closeOverlay();
                        endTurn();
                    };
                }
                list.appendChild(item);
            });
            overlay.style.display = "flex";
        }

        function closeOverlay() {
            document.getElementById("selection-overlay").style.display = "none";
        }

        function executeAttack(move) {
            const attacker = (turn === 1) ? p1BattleDeck[p1ActiveIndex] : p2BattleDeck[p2ActiveIndex];
            const defender = (turn === 1) ? p2BattleDeck[p2ActiveIndex] : p1BattleDeck[p1ActiveIndex];

            // ダメージ計算 (技の威力ベース)
            let baseDamage = move.d;
            if (baseDamage === 0) {
                // 特殊行動（バフっぽく見せる）
                addLog(attacker.name + " の " + move.n + "！ 気合を入れた！");
                if (!isGameOver) endTurn();
                return;
            }

            let damage = (baseDamage * (attacker.A / 100)) - (defender.D / 4) + Math.floor(Math.random() * 10);
            if (damage < 20) damage = 20;
            damage = Math.floor(damage);

            defender.H -= damage;
            if (defender.H < 0) defender.H = 0;

            addLog(attacker.name + " の " + move.n + "！ " + damage + " ダメージ！");

            const targetId = (turn === 1) ? "p2-active-card" : "p1-active-card";
            const targetEl = document.getElementById(targetId);
            targetEl.animate([
                { transform: 'translateX(0)' },
                { transform: 'translateX(5px)' },
                { transform: 'translateX(-5px)' },
                { transform: 'translateX(0)' }
            ], { duration: 100 });

            if (defender.H === 0) {
                addLog(defender.name + " は倒れた！");
                checkVictory();
                if (!isGameOver) {
                    // 相手が倒れたら交代画面を強制
                    forceSwitchMenu(turn === 1 ? 2 : 1);
                    return;
                }
            }
            if (!isGameOver) endTurn();
        }

        function forceSwitchMenu(targetPlayer) {
            const originalTurn = turn;
            turn = targetPlayer; // 一時的にターンを切り替えてメニューを表示
            showSwitchMenu();
            // 戻るボタンを隠して強制する
            document.querySelector(".close-btn").style.display = "none";
            // 交代後にターンを戻すなどの処理が必要だが、シンプルにするためこのまま
            // ※実際には交代処理内でturn制御を行う
            const originalClose = closeOverlay;
            closeOverlay = function () {
                originalClose();
                document.querySelector(".close-btn").style.display = "block";
                closeOverlay = originalClose;
            };
        }

        function endTurn() {
            turn = (turn === 1) ? 2 : 1;
            updateBattleUI();
        }

        function checkVictory() {
            const p1Alive = p1BattleDeck.some(function (p) { return p.H > 0; });
            const p2Alive = p2BattleDeck.some(function (p) { return p.H > 0; });
            if (!p1Alive || !p2Alive) {
                isGameOver = true;
                const winner = p1Alive ? "プレイヤー 1" : "プレイヤー 2";
                addLog("=== 決着！ " + winner + " の勝利！ ===");
            }
        }

        function updateBattleUI() {
            renderCard("p1", p1BattleDeck[p1ActiveIndex]);
            renderCard("p2", p2BattleDeck[p2ActiveIndex]);
            document.getElementById("attack-btn").disabled = isGameOver;
            document.getElementById("switch-btn").disabled = isGameOver;
        }

        function renderCard(pId, card) {
            const el = document.getElementById(pId + "-active-card");
            const master = MASTER_CARDS.find(function (m) { return m.name === card.name });
            const hpPercent = (card.H / master.H) * 100;

            el.innerHTML =
                '<div class="card-glare"></div>' +
                '<div style="text-align:center; font-weight:900; font-size:18px; color:#1e293b;">' + card.name + '</div>' +
                '<i class="fas ' + card.icon + '" style="font-size:70px; color:' + master.color + '; margin:30px 0; display:block; text-align:center; filter:drop-shadow(0 4px 10px ' + master.color + '66)"></i>' +
                '<div class="hp-bar-outer"><div class="hp-bar-inner" style="width:' + hpPercent + '%"></div></div>' +
                '<div style="font-size:12px; text-align:right; color:#64748b; font-weight:bold;">HP ' + card.H + ' / ' + master.H + '</div>' +
                '<div class="stat-display-bl" style="display:flex; gap:4px; font-size:7px;">' +
                '<span style="background:#fee2e2; border:1px solid #fecaca; padding:1px 3px; border-radius:4px;">H' + card.H + '</span>' +
                '<span style="background:#fef9c3; border:1px solid #fef08a; padding:1px 3px; border-radius:4px;">I' + card.I + '</span>' +
                '<span style="background:#f0f9ff; border:1px solid #bae6fd; padding:1px 3px; border-radius:4px;">J' + card.J + '</span>' +
                '<span style="background:#f0fdf4; border:1px solid #bbf7d0; padding:1px 3px; border-radius:4px;">G' + card.G + '</span>' +
                '<span style="background:#faf5ff; border:1px solid #e9d5ff; padding:1px 3px; border-radius:4px;">F' + card.F + '</span>' +
                '<span style="background:#f1f5f9; border:1px solid #e2e8f0; padding:1px 3px; border-radius:4px;">D' + card.D + '</span>' +
                '<span style="background:#fff7ed; border:1px solid #ffedd5; padding:1px 3px; border-radius:4px;">A' + card.A + '</span>' +
                '</div>';

            // ポケポケ風エフェクトをつける
            attachCardEffects(el);
        }

        /**
         * マウスに合わせて傾けたり、キラキラさせたりします
         */
        function attachCardEffects(el) {
            el.onmousemove = function (e) {
                const rect = el.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                const rotateX = (y - centerY) / 10;
                const rotateY = (centerX - x) / 10;

                el.style.transform = "rotateX(" + rotateX + "deg) rotateY(" + rotateY + "deg)";

                const glare = el.querySelector(".card-glare");
                const glareX = (x / rect.width) * 100;
                const glareY = (y / rect.height) * 100;
                glare.style.background = "radial-gradient(circle at " + glareX + "% " + glareY + "%, rgba(255,255,255,0.6) 0%, rgba(255,255,255,0) 60%)";
            };

            el.onmouseleave = function () {
                el.style.transform = "rotateX(0deg) rotateY(0deg)";
                const glare = el.querySelector(".card-glare");
                glare.style.opacity = 0;
            };

            el.onmouseenter = function () {
                const glare = el.querySelector(".card-glare");
                glare.style.opacity = 1;
            };
        }

        function showSwitchMenu() {
            const deck = (turn === 1) ? p1BattleDeck : p2BattleDeck;
            let choice = prompt("交代する番号を選んでください:\n" + deck.map(function (p, i) { return (i + 1) + ":" + p.name + " (HP:" + p.H + ")"; }).join("\n"));
            let idx = parseInt(choice) - 1;
            if (deck[idx] && deck[idx].H > 0 && idx !== (turn === 1 ? p1ActiveIndex : p2ActiveIndex)) {
                if (turn === 1) p1ActiveIndex = idx; else p2ActiveIndex = idx;
                addLog("P" + turn + " は " + deck[idx].name + " に交代した！");
                endTurn();
            }
        }

        function addLog(msg) {
            const logArea = document.getElementById("log-area");
            const div = document.createElement("div");
            div.style.marginBottom = "4px";
            div.innerText = "● " + msg;
            logArea.appendChild(div);
            logArea.scrollTop = logArea.scrollHeight;
        }

        initSetup();
    </script>
</body>

</html>

